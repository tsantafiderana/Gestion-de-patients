<Window x:Class="WpfBasics.ModalPatient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau Patient"
        Height="580" Width="540"
        WindowStartupLocation="CenterScreen"
        Background="#f5f5f5"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Text="Nouveau Patient"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#00355f"
                   Margin="0,0,0,25"/>

        <!-- Formulaire -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ID Patient + Sexe -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ID Patient :" VerticalAlignment="Center" Foreground="#333"/>
                    <TextBox Grid.Column="1" Height="32" Padding="6,4"
                             VerticalContentAlignment="Center" x:Name="txtIdPatient"/>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Sexe :" VerticalAlignment="Center" Foreground="#333"/>
                    <ComboBox Grid.Column="1" Height="32" VerticalContentAlignment="Center" x:Name="cbSexe">
                        <ComboBoxItem Content="M"/>
                        <ComboBoxItem Content="F"/>
                    </ComboBox>
                </Grid>
            </Grid>

            <!-- Nom -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Nom :" VerticalAlignment="Center" Foreground="#333"/>
                <TextBox Grid.Column="1" Height="32" Padding="6,4"
                         VerticalContentAlignment="Center" x:Name="txtNom"/>
            </Grid>

            <!-- Prénom -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Prénom :" VerticalAlignment="Center" Foreground="#333"/>
                <TextBox Grid.Column="1" Height="32" Padding="6,4"
                         VerticalContentAlignment="Center" x:Name="txtPrenom"/>
            </Grid>

            <!-- Adresse -->
            <Grid Grid.Row="3" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Adresse :" VerticalAlignment="Center" Foreground="#333"/>
                <TextBox Grid.Column="1" Height="32" Padding="6,4"
                         VerticalContentAlignment="Center" x:Name="txtAdresse"/>
            </Grid>

            <!-- Date + Groupe sanguin -->
            <Grid Grid.Row="4" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Date naissance :" VerticalAlignment="Center" Foreground="#333"/>
                    <DatePicker Grid.Column="1" Height="32" VerticalContentAlignment="Center"
                                x:Name="dpNaissance"/>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Groupe sanguin :" VerticalAlignment="Center" Foreground="#333"/>
                    <ComboBox Grid.Column="1" Height="32" VerticalContentAlignment="Center"
                              x:Name="cbGroupeSanguin">
                        <ComboBoxItem Content="A Rh+"/>
                        <ComboBoxItem Content="A Rh-"/>
                        <ComboBoxItem Content="B Rh+"/>
                        <ComboBoxItem Content="B Rh-"/>
                        <ComboBoxItem Content="O Rh+"/>
                        <ComboBoxItem Content="O Rh-"/>
                        <ComboBoxItem Content="AB Rh+"/>
                        <ComboBoxItem Content="AB Rh-"/>
                    </ComboBox>
                </Grid>
            </Grid>

            <!-- Téléphone -->
            <Grid Grid.Row="5" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Téléphone :" VerticalAlignment="Center" Foreground="#333"/>
                <TextBox Grid.Column="1" Height="32" Padding="6,4"
                         VerticalContentAlignment="Center" x:Name="txtTelephone"/>
            </Grid>

            <!-- Email -->
            <Grid Grid.Row="6" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Email :" VerticalAlignment="Center" Foreground="#333"/>
                <TextBox Grid.Column="1" Height="32" Padding="6,4"
                         VerticalContentAlignment="Center" x:Name="txtEmail"/>
            </Grid>

            <!-- CIN -->
            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="CIN :" VerticalAlignment="Center" Foreground="#333"/>
                <TextBox Grid.Column="1" Height="32" Padding="6,4"
                         VerticalContentAlignment="Center" x:Name="txtCin"/>
            </Grid>
        </Grid>

        <!-- Boutons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
            <Button Content="Annuler"
                    Width="110" Height="36"
                    Margin="0,0,12,0"
                    Background="#9e9e9e" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    Click="BtnAnnuler_Click"/>
            <Button Content="Enregistrer"
                    Width="130" Height="36"
                    Background="#00355f" Foreground="White"
                    BorderThickness="0" Cursor="Hand"
                    FontWeight="SemiBold"
                    Click="BtnEnregistrer_Click"/>
        </StackPanel>
    </Grid>
</Window>