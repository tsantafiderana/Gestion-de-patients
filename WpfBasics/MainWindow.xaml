<Window x:Class="WpfBasics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfBasics"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
        
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1000"  WindowState="Maximized">
    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"></ColumnDefinition>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1f2533">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" >
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10 25 0 10" Width="225">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#1864dc" Margin="10 0 10 0" CornerRadius="10">
                                    <mah:PackIconLucide Kind="Stethoscope" Margin="7.5" Width="20" Height="20" Foreground="white"/>
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="MedFlow Clinical"
                                           FontSize="16"
                                           Foreground="white"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="5 0 0 0"/>
                            </Grid>

                        </StackPanel>

                        <TextBlock Text="NAVIGATION" Margin="20,20,20,5" Foreground="#737781" FontSize="11" FontWeight="SemiBold"/>

                        <ListBox BorderThickness="0" Background="Transparent" SelectionChanged="ListeBox_SelectionChanged">
                            <!--<ListBoxItem Padding="20,12" Tag="DashboardOverview">
                                <StackPanel Orientation="Horizontal">
                                    <mah:PackIconLucide Kind="LayoutDashboard" Margin="0 0 10 0" Width="18" Height="18" Foreground="white"/>
                                    <TextBlock Text="Dashboard" FontSize="14" FontWeight="SemiBold" Foreground="white"/>
                                </StackPanel>

                            </ListBoxItem>-->
                            <ListBoxItem Padding="20,12" Tag="DashboardPatient">
                                <StackPanel Orientation="Horizontal">
                                    <mah:PackIconLucide Kind="UsersRound" Margin="0 0 10 0" Width="18" Height="18" Foreground="white"/>
                                    <TextBlock Text="Patients" FontSize="14" FontWeight="SemiBold" Foreground="white"/>
                                </StackPanel>

                            </ListBoxItem>
                            <ListBoxItem Padding="20,12" Tag="MedicalRecords">
                                <StackPanel Orientation="Horizontal">
                                    <mah:PackIconLucide Kind="FileArchive" Margin="0 0 10 0" Width="18" Height="18" Foreground="white"/>
                                    <TextBlock Text="Dossiers Médicaux" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>

                            </ListBoxItem>
                            <ListBoxItem Padding="20,12" Tag="appointments">
                                <StackPanel Orientation="Horizontal">
                                    <mah:PackIconLucide Kind="Calendar1" Margin="0 0 10 0" Width="18" Height="18" Foreground="white"/>
                                    <TextBlock Text="Rendez-vous" FontSize="14" FontWeight="SemiBold" Foreground="white"/>
                                </StackPanel>

                            </ListBoxItem>
                            <ListBoxItem Padding="20,12" Tag="docteurs">
                                <StackPanel Orientation="Horizontal">
                                    <mah:PackIconLucide Kind="Stethoscope" Margin="0 0 10 0" Width="18" Height="18" Foreground="white"/>
                                    <TextBlock Text="Docteurs" FontSize="14" FontWeight="SemiBold" Foreground="white"/>
                                </StackPanel>

                            </ListBoxItem>
                        <!--</ListBox>-->

                        <TextBlock Text="ADMINISTRATION" Margin="20,20,20,5" Foreground="#7F8C8D" FontSize="11" FontWeight="SemiBold"/>
                        <!--<ListBox BorderThickness="0" Background="Transparent" SelectionChanged="ListeBox_SelectionChanged">-->
                            <ListBoxItem Padding="20,12" Selected="ListBoxItem_Selected" Tag="finance">
                                <StackPanel Orientation="Horizontal">
                                    <mah:PackIconLucide Kind="Wallet" Margin="0 0 10 0" Width="18" Height="18" Foreground="white"/>
                                    <TextBlock Text="Finances" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>

                            </ListBoxItem>
                            <ListBoxItem Padding="20,12" Tag="rapportsMedicaux">
                                <StackPanel Orientation="Horizontal">
                                    <mah:PackIconLucide Kind="ChartArea" Margin="0 0 10 0" Width="18" Height="18" Foreground="white"/>
                                    <TextBlock Text="Rapports" FontSize="14" FontWeight="SemiBold" Foreground="white"/>
                                </StackPanel>

                            </ListBoxItem>
                        </ListBox>

                    </StackPanel>

                    
                    
                    
                </Grid>
                
                
                
            </Border>

            <Border Grid.Column="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border  Grid.Row="0" Padding="15" Background="#d4dbe8" BorderBrush="Gray" BorderThickness="0.5 0 0 0.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>



                            <Border Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Height="25">
                                   
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <ContentControl x:Name="MainContent" Grid.Row="1"/>
                </Grid>
            </Border>

        </Grid>


    </Border>

</Window>
