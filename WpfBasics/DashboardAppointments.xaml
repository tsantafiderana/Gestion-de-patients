<UserControl x:Class="WpfBasics.DashboardAppointments"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:WpfBasics"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#F5F7FA">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ConfirmedBrush" Color="#3B82F6"/>
        <SolidColorBrush x:Key="WaitingBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="CompletedBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="CancelledBrush" Color="#EF4444"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F4F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewModeButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
        <Style x:Key="StatusChipStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="12" Padding="10,4" Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              CanContentScroll="False">


        <StackPanel >
            <Grid Margin="10,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="28" Grid.Column="0"
               FontWeight="SemiBold"
               Foreground="#1f2937"
               Margin="0,0,0,4"
               Text="Rendez-Vous" />

                <Button Grid.Column="2"
                        x:Name="btn_newRdv"
                        Content="Nouveau Rendez-Vous"
                        Height="40"
                        Padding="18,0"
                        Background="#3B82F6"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand" Click="btn_newRdv_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>


            </Grid>
            <Border Background="White" Margin="20,0,20,20" 
                    BorderBrush="#E5E7EB" BorderThickness="1" 
                    CornerRadius="12" Padding="0">
                <StackPanel>
                    <Border Padding="20,16" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                        <Grid>
                            
                            <Border Padding="20,16" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Date + flèches de navigation -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                                        <!-- Bouton Jour précédent -->
                                        <Button Content="◀" 
                                                Style="{StaticResource NavButtonStyle}"
                                                Width="36" Height="36"
                                                Margin="0,0,8,0"
                                                Click="PreviousDay_Click"
                                                ToolTip="Jour précédent"/>

                                        <!-- Titre de l'agenda -->
                                        <TextBlock x:Name="DailyAgendaTitle"
                                               Text="Agenda du ..."
                                               FontSize="15" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="#111827"
                                               Margin="0,0,8,0"/>

                                        <!-- Bouton Jour suivant -->
                                        <Button Content="▶" 
                                                Style="{StaticResource NavButtonStyle}"
                                                Width="36" Height="36"
                                                Click="NextDay_Click"
                                                ToolTip="Jour suivant"/>
                                    </StackPanel>

                                    <!-- Filtres à droite -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                                        <!-- DatePicker pour choisir une date précise -->
                                        <DatePicker x:Name="DatePickerAgenda"
                                                    Width="140"
                                                    Height="36"
                                                    Margin="0,0,16,0"
                                                    SelectedDateChanged="DatePickerAgenda_SelectedDateChanged"
                                                    VerticalContentAlignment="Center"/>

                                        <TextBlock Text="Docteur :"
                                                   VerticalAlignment="Center"
                                                   Foreground="#6B7280"
                                                   FontSize="13"
                                                   Margin="0,0,8,0"/>

                                        <ComboBox x:Name="cbOptions"
                                                  MinWidth="160"
                                                  Height="36"
                                                  Padding="10,0"
                                                  FontSize="13"
                                                  VerticalContentAlignment="Center"
                                                  BorderBrush="#E5E7EB"
                                                  BorderThickness="1"
                                                  Background="White"
                                                  ItemsSource="{Binding ListeDocteurs}"
                                                  DisplayMemberPath="NomComplet"
                                                  SelectedValuePath="IdDocteur"
                                                  SelectionChanged="DoctorFilter_SelectionChanged">

                                            <ComboBox.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </ComboBox.Resources>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            
                        </Grid>
                        
                    </Border>


                    <!-- ==================== RENDEZ-VOUS ACTIFS (prévu + confirmé) ==================== -->
                    <TextBlock Text="Rendez-vous du jour"
           FontSize="14"
           FontWeight="SemiBold"
           Foreground="#374151"
           Margin="20,12,0,6"/>

                    <ItemsControl x:Name="DailyAppointmentsList" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- ... ton DataTemplate existant (ne change rien) ... -->
                                <Grid Margin="0,0,0,0" MinHeight="64">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                           Text="{Binding TimeLabel}"
                           FontSize="13" Foreground="#9CA3AF"
                           VerticalAlignment="Top"
                           Margin="20,18,0,0"
                           HorizontalAlignment="Right"/>

                                    <Border Grid.Column="1"
                        Margin="12,6,16,6"
                        Background="White"
                        BorderBrush="#F3F4F6"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                              Opacity="0.06" Direction="270"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                Background="{Binding StatusColor}"
                                CornerRadius="10,0,0,10"/>

                                            <StackPanel Grid.Column="1" Margin="16,12,12,12" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Time}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#374151"
                                           Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding PatientName}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#111827"/>
                                                    <TextBlock Text=" · " Foreground="#9CA3AF"/>
                                                    <TextBlock Text="{Binding AppointmentType}"
                                           FontSize="13" Foreground="#6B7280"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DoctorAndRoom}"
                                       FontSize="12" Foreground="#9CA3AF"
                                       Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0">
                                                <!-- Badge de Statut -->
                                                <Border Background="{Binding StatusBg}"
                                    CornerRadius="12"
                                    Padding="10,4"
                                    Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7"
                                             Fill="{Binding StatusColor}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding StatusText}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="#374151"/>
                                                    </StackPanel>
                                                </Border>

                                                <Button Content="Terminé"
                                    Style="{StaticResource NavButtonStyle}"
                                    Padding="12,5"
                                    Margin="0,0,6,0"
                                    Click="btn_complete_Click"
                                    Tag="{Binding}"/>

                                                <Button Content="Annuler"
                                    Foreground="#EF4444"
                                    Style="{StaticResource NavButtonStyle}"
                                    Padding="12,5"
                                    Margin="0,0,6,0"
                                    Click="btn_cancel_Click"
                                    Tag="{Binding}"/>

                                                <Button Style="{StaticResource NavButtonStyle}"
                                    ToolTip="Modifier"
                                    Padding="8,5"
                                    Tag="{Binding}"
                                    Click="EditAppointment_Click">
                                                    <mah:PackIconLucide Kind="SquarePen" Width="16" Height="16" Foreground="#6B7280"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ==================== RENDEZ-VOUS TERMINÉS / ANNULÉS ==================== -->
                    <TextBlock x:Name="CompletedCancelledTitle"
           Text="Terminés &amp; Annulés"
           FontSize="14"
           FontWeight="SemiBold"
           Foreground="#6B7280"
           Margin="20,8,0,6"
           Visibility="Collapsed"/>

                    <ItemsControl x:Name="CompletedCancelledList" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Même template, mais on peut griser un peu si tu veux -->
                                <Grid Margin="0,0,0,0" MinHeight="64" Opacity="0.75">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                           Text="{Binding TimeLabel}"
                           FontSize="13" Foreground="#9CA3AF"
                           VerticalAlignment="Top"
                           Margin="20,18,0,0"
                           HorizontalAlignment="Right"/>

                                    <Border Grid.Column="1"
                        Margin="12,6,16,6"
                        Background="White"
                        BorderBrush="#F3F4F6"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                              Opacity="0.06" Direction="270"/>
                                        </Border.Effect>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                Background="{Binding StatusColor}"
                                CornerRadius="10,0,0,10"/>

                                            <StackPanel Grid.Column="1" Margin="16,12,12,12" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Time}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="#374151"
                                           Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding PatientName}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#111827"/>
                                                    <TextBlock Text=" · " Foreground="#9CA3AF"/>
                                                    <TextBlock Text="{Binding AppointmentType}"
                                           FontSize="13" Foreground="#6B7280"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DoctorAndRoom}"
                                       FontSize="12" Foreground="#9CA3AF"
                                       Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,16,0">
                                                <!-- Badge de Statut -->
                                                <Border Background="{Binding StatusBg}"
                                    CornerRadius="12"
                                    Padding="10,4"
                                    Margin="0,0,10,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="7" Height="7"
                                             Fill="{Binding StatusColor}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding StatusText}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="#374151"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- On peut cacher les boutons Terminé / Annuler ici si tu veux -->
                                                <Button Style="{StaticResource NavButtonStyle}"
                                    ToolTip="Modifier"
                                    Padding="8,5"
                                    Tag="{Binding}"
                                    Click="EditAppointment_Click">
                                                    <mah:PackIconLucide Kind="SquarePen" Width="16" Height="16" Foreground="#6B7280"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>