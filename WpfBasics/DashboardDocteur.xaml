<UserControl x:Class="WpfBasics.DashboardDocteur"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfBasics"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Opacity="0.08"
                          Direction="270"
                          Color="Black"/>
    </UserControl.Resources>

    <Border Padding="15" Background="#F5F7FA">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                
            </Grid.RowDefinitions>

            <!-- ========== Titre ========== -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#1f2937"
                           Margin="0,0,0,4"
                           Text="Docteurs" />
                <TextBlock FontSize="14"
                           FontWeight="Light"
                           x:Name="txtNombrePatients"/>
            </StackPanel>

            <!-- ========== Filtre + Bouton Nouveau ========== -->
            <Border Grid.Row="1"
                    Background="White"
                    Padding="15"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
         x:Name="SearchBox"
         Background="#F3F4F6"
         Margin="0,0,15,0"
         Padding="10,8"
         FontSize="14"
         Text="Rechercher..."
         Foreground="Gray"
         BorderBrush="#E5E7EB"
         BorderThickness="1"
         VerticalContentAlignment="Center"
         TextChanged="SearchBox_TextChanged"
         GotFocus="SearchBox_GotFocus"
         LostFocus="SearchBox_LostFocus"/>

                    <Button Grid.Column="1"
                            Content="Nouveau Docteur"
                            Height="40"
                            Padding="18,0"
                            Background="#3B82F6"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand" Click="Button_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- ========== Affichage des docteurs ========== -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ItemsControl ItemsSource="{Binding Docteurs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12"
                                    Padding="18"
                                    Margin="0,0,15,15"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    Width="290"
                                    Effect="{StaticResource CardShadow}">

                                <StackPanel>
                                    <!-- Header : Avatar + Nom + Spécialité -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="48" Height="48"
                                                CornerRadius="24"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center">

                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#6B7280"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Sexe}" Value="M">
                                                            <Setter Property="Background" Value="#3B82F6"/>
                                                        </DataTrigger>
                                                        
                                                        <DataTrigger Binding="{Binding Sexe}" Value="F">
                                                            <Setter Property="Background" Value="#EC4899"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <TextBlock Text="{Binding Initials}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nom}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1F2937"/>
                                            <TextBlock Text="{Binding Prenom}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1F2937"/>
                                            
                                    <TextBlock Text="{Binding Specialite}"
                                               FontSize="13"
                                               Foreground="#6B7280"
                                               Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>


                                    <!-- Statut -->
                                  <!--  <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,14"
                                                VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#22C55E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstDisponible}" Value="False">
                                                            <Setter Property="Fill" Value="#F59E0B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <TextBlock Text="{Binding Statut}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#16A34A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EstDisponible}" Value="False">
                                                            <Setter Property="Foreground" Value="#D97706"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel> -->

                                    <!-- Patients + Today -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="#F9FAFB"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Margin="0,0,6,0">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <iconPacks:PackIconLucide Kind="Users"
                                                                              Width="14" Height="14"
                                                                              Foreground="#6B7280"
                                                                              Margin="0,0,5,0"
                                                                              VerticalAlignment="Center"/>
                                                    <TextBlock Text="Consultations"
                                                               FontSize="11"
                                                               Foreground="#6B7280"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding NombreConsultation}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1F2937"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Background="#F9FAFB"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Margin="6,0,0,0">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <iconPacks:PackIconLucide Kind="Calendar"
                                                                              Width="14" Height="14"
                                                                              Foreground="#6B7280"
                                                                              Margin="0,0,5,0"
                                                                              VerticalAlignment="Center"/>
                                                    <TextBlock Text="RDV aujourd'hui"
                                                               FontSize="11"
                                                               Foreground="#6B7280"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding NombreRdv}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1F2937"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Téléphone -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <iconPacks:PackIconLucide Kind="Phone"
                                                                  Width="14" Height="14"
                                                                  Foreground="#6B7280"
                                                                  Margin="0,0,8,0"
                                                                  VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Telephone}"
                                                   FontSize="13"
                                                   Foreground="#4B5563"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Email -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <iconPacks:PackIconLucide Kind="Mail"
                                                                  Width="14" Height="14"
                                                                  Foreground="#6B7280"
                                                                  Margin="0,0,8,0"
                                                                  VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Email}"
                                                   FontSize="13"
                                                   Foreground="#4B5563"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Boutons -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Content="Modifier"
                                                Height="36"
                                                Margin="0,0,6,0"
                                                Background="#DBEAFE"
                                                Foreground="#1D4ED8"
                                                BorderThickness="0"
                                                FontWeight="SemiBold"
                                                Click="BtnEdit_Click"
                                                Tag="{Binding}"
                                                Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button Grid.Column="1"
                                                Content="Supprimer"
                                                Height="36"
                                                Margin="6,0,0,0"
                                                Background="White"
                                                Foreground="#374151"
                                                BorderBrush="#D1D5DB"
                                                BorderThickness="1"
                                                FontWeight="SemiBold"
                                                Click="BtnDelete_Click"
                                                Tag="{Binding}"
                                                Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>