<Window x:Class="WpfBasics.ModalRdv"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfBasics"   
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        Title="Nouveau Docteur"
        Width="480"
        Height="640"
        
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Border Background="White"                
                Width="480"            
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="28">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <TextBlock x:Name="TitreModal"
                Text="Nouveau Rendez-Vous"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="#111827"
                VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Grid.Row="1">
                <TextBlock Text="ID RENDEZ-VOUS"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="#6B7280"
                       Margin="0,0,0,6"/>
                <TextBox x:Name="txtIdRdv"
                     Height="40"
                     Padding="12,0"
                     VerticalContentAlignment="Center"
                     FontSize="14"
                     BorderBrush="#E5E7EB"
                     BorderThickness="1"
                     Background="White"
                     Margin="0,0,0,18">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="NOM DU PATIENT :"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#6B7280"
                           Margin="0,0,0,6"/>       
                <ComboBox x:Name="cbPatient"
                              Margin="0 0 0 18"
                              MinWidth="160"
                              Height="36"
                              Padding="10,0"
                              FontSize="13"
                              VerticalContentAlignment="Center"
                              BorderBrush="#E5E7EB"
                              BorderThickness="1"
                              Background="White"
                              ItemsSource="{Binding ListePatients}"
                              DisplayMemberPath="NomComplet"
                              SelectedValuePath="IdPatient">
                        <!--SelectionChanged="DoctorFilter_SelectionChanged"-->

                        <ComboBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </ComboBox.Resources>
                    </ComboBox>
                
              
                    <TextBlock Text="NOM DU DOCTEUR"
                               VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#6B7280"
                           Grid.Column="0"
                           Margin="0,0,0,6"/>
                    <ComboBox x:Name="cbDocteur"
                              Margin="0 0 0 18"
                              MinWidth="160"
                              Height="36"
                              Padding="10,0"
                              FontSize="13"
                              VerticalContentAlignment="Center"
                              BorderBrush="#E5E7EB"
                              BorderThickness="1"
                              Background="White"
                              ItemsSource="{Binding ListeDocteurs}"
                              DisplayMemberPath="NomComplet"
                              SelectedValuePath="IdDocteur">
                        <!--SelectionChanged="DoctorFilter_SelectionChanged"-->

                        <ComboBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </ComboBox.Resources>
                    </ComboBox>
                

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DATE DE RENDEZ-VOUS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,6"/>
                        <DatePicker Padding="12,0"
                                    Height="40"
                                    x:Name="inputDate"
                                    VerticalContentAlignment="Center"
                                    FontSize="14"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    Background="White"/>


                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="HEURE DE RENDEZ-VOUS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,6"/>

                        <mah:TimePicker x:Name="tpHeureRdv"
                                    Height="40"
                                    Padding="12,0"
                                    FontSize="14"
                                    VerticalContentAlignment="Center"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    Background="White"
                                    IsClockVisible="True"
                                    SelectedTimeFormat="Short"
                                    Style="{DynamicResource MahApps.Styles.TimePicker}">    

                            <!-- On charge les ressources MahApps UNIQUEMENT pour ce contrôle -->
                            <mah:TimePicker.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.MergedDictionaries>
                                        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                                        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                                        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml" />
                                    </ResourceDictionary.MergedDictionaries>

                                    <!-- Coin arrondi -->
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </ResourceDictionary>
                            </mah:TimePicker.Resources>
                        </mah:TimePicker>




                    </StackPanel>
                    

                </Grid>
                <TextBlock Text="DESCRIPTION"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#6B7280"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="txtDescription"
                         Height="40"
                         Padding="12,0"
                         
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         BorderBrush="#E5E7EB"
                         BorderThickness="1"
                         Background="White"
                         Margin="0,0,0,18">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="STATUT :"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#6B7280"
                           Margin="0,0,0,6"/>
                <ComboBox x:Name="cbStatut"
                          Margin="0 0 0 18"
                          MinWidth="160"
                          Height="36"
                          Padding="10,0"
                          FontSize="13"
                          VerticalContentAlignment="Center"
                          BorderBrush="#E5E7EB"
                          BorderThickness="1"
                          SelectedIndex="0"
                          Background="White">
                                <!--SelectionChanged="DoctorFilter_SelectionChanged"-->
                        <ComboBoxItem Content="Prévu" Tag="prevu"/>
                    <ComboBoxItem Content="Confirmé" Tag="confirme"/>
                    <ComboBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="Cancel"
                        Grid.Column="1"
                        Height="40"
                        Padding="22,0"
                        Margin="0,0,12,0"
                        Background="White"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        FontSize="14"
                        Cursor="Hand"                        >
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnSave"
                        Grid.Column="2"
                        Content="Enregistrer"
                        Height="40"
                        Padding="28,0"
                        Background="#3B82F6"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        FontSize="14"
                        Cursor="Hand" Click="BtnSave_Click"
                        >
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
