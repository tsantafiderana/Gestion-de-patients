<UserControl x:Class="WpfBasics.DashboardPatient"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfBasics"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">

    <UserControl.Resources>
        
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="16"
                          ShadowDepth="2"
                          Opacity="0.06"
                          Direction="270"
                          Color="Black"/>

        
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Padding="24" Background="#F0F4F8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ===================== COLONNE GAUCHE ===================== -->
            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Titre + Bouton Nouveau -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Patients"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"/>
                        <TextBlock x:Name="txtNombrePatients"
                                   FontSize="14"
                                   Foreground="#6B7280"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="+  Nouveau Patient"
                            Height="42"
                            Padding="20,0"
                            Background="#3B82F6"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            FontSize="14"
                            Cursor="Hand"
                            Click="Button_Click"
                            VerticalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- Barre de recherche + Tri -->
                <Border Grid.Row="1"
                        Background="White"
                        CornerRadius="12"
                        Padding="16,12"
                        Margin="0,0,0,16"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search -->
                        <Border Grid.Column="0"
                                Background="#F9FAFB"
                                CornerRadius="10"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Padding="12,0"
                                Height="42"
                                Margin="0,0,16,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <mah:PackIconLucide Kind="Search"
                                                    Width="16" Height="16"
                                                    Foreground="#9CA3AF"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0"/>
                                <TextBox x:Name="SearchBox"
                                         Grid.Column="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         FontSize="14"
                                         Foreground="#374151"
                                         TextChanged="SearchBox_TextChanged"/>
                                <!--="Rechercher un patient, un email, un identifiant..."/ -->
                            </Grid>
                        </Border>

                        <!-- Tri -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!--<TextBlock Text="Trier par :"
                                       VerticalAlignment="Center"
                                       Foreground="#6B7280"
                                       FontSize="13"
                                       Margin="0,0,10,0"/>
                            <ComboBox x:Name="cbOptions"
                                      Width="140"
                                      Height="42"
                                      Padding="10,0"
                                      FontSize="13"
                                      VerticalContentAlignment="Center"
                                      BorderBrush="#E5E7EB"
                                      BorderThickness="1"
                                      Background="White">
                                <ComboBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBoxItem Content="Sexe" IsSelected="True"/>
                                <ComboBoxItem Content="Ordre Alphabétique"/>
                                <ComboBoxItem Content="Numéro d'Id"/>
                            </ComboBox>-->
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tableau -->
                <Border Grid.Row="2"
                        Background="White"
                        CornerRadius="14"
                        Padding="0"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- En-tête du tableau -->
                        <Border Grid.Row="0"
                                Background="#F9FAFB"
                                BorderBrush="#F3F4F6"
                                BorderThickness="0,0,0,1"
                                Padding="20,14"
                                CornerRadius="14,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="2.4*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="IDPATIENT" FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                <TextBlock Grid.Column="1" Text="PATIENT"   FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                <TextBlock Grid.Column="2" Text="EMAIL"     FontSize="11" FontWeight="SemiBold" Foreground="#6B7280"/>
                                <TextBlock Grid.Column="3" Text="ÂGE"       FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="SEXE"      FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="ACTIONS"   FontSize="11" FontWeight="SemiBold" Foreground="#6B7280" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Lignes -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredPatients}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#F3F4F6"
                                                BorderThickness="0,0,0,1"
                                                Padding="20,14"
                                                Background="Transparent">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F8FAFC"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="2.2*"/>
                                                    <ColumnDefinition Width="2.4*"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- ID -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding IdPatient}"
                                                           FontSize="13"
                                                           Foreground="#374151"
                                                           VerticalAlignment="Center"/>

                                                <!-- Patient (avatar + nom) -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="36" Height="36"
                                                            CornerRadius="18"
                                                            Margin="0,0,12,0"
                                                            Background="#3b82f6"
                                                            VerticalAlignment="Center">
                                                        
                                                        <TextBlock Text="{Binding Initials}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Orientation="Vertical">
                                                        <TextBlock Text="{Binding Nom}"
                                                               FontSize="14"
                                                               FontWeight="Medium"
                                                               Foreground="#111827"
                                                               VerticalAlignment="Center"/>
                                                               <!--TextWrapping="Wrap"-->
                                                        <TextBlock Text="{Binding Prenom}"
                                                               FontSize="14"
                                                               FontWeight="Medium"
                                                               Foreground="#111827"
                                                               VerticalAlignment="Center"/>
                                                               <!--TextWrapping="Wrap"-->
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Email -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Contact}"
                                                           FontSize="13"
                                                           Foreground="#6B7280"
                                                           VerticalAlignment="Center"/>

                                                <!-- Âge -->
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding Age}"
                                                           FontSize="13"
                                                           Foreground="#374151"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>

                                                <!-- Sexe (badge rond) -->
                                                <Border Grid.Column="4"
                                                        Width="28" Height="28"
                                                        CornerRadius="14"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                   
                                                    <TextBlock Text="{Binding Sexe}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#1D4ED8"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Sexe}" Value="F">
                                                                        <Setter Property="Foreground" Value="#BE185D"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="5"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ActionButton}"
                                                            Command="{Binding DataContext.ViewPatientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Voir">
                                                        <mah:PackIconLucide Kind="Eye" Width="16" Height="16" Foreground="#6B7280"/>
                                                    </Button>
                                                    <Button Style="{StaticResource ActionButton}"
                                                            Command="{Binding DataContext.EditPatientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Modifier"
                                                            Margin="4,0">
                                                        <mah:PackIconLucide Kind="SquarePen" Width="16" Height="16" Foreground="#6B7280"/>
                                                    </Button>
                                                    <Button Style="{StaticResource ActionButton}"
                                                            Command="{Binding DataContext.DeletePatientCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Supprimer">
                                                        <mah:PackIconLucide Kind="Trash2" Width="16" Height="16" Foreground="#6B7280"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===================== COLONNE DROITE (Détail) ===================== -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="16"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header sombre -->
                    <Border Grid.Row="0"
                            Background="#0F172A"
                            CornerRadius="16,16,0,0"
                            Padding="20,22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="56" Height="56"
                                    CornerRadius="14"
                                    Background="#1E3A8A"
                                    BorderBrush="#3B82F6"
                                    BorderThickness="2"
                                    Margin="0,0,14,0">
                                <mah:PackIconLucide Kind="User"
                                                    Width="28" Height="28"
                                                    Foreground="White"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedPatient.NomComplet, TargetNullValue='Aucun patient sélectionné'}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <mah:PackIconLucide Kind="Calendar"
                                                        Width="14" Height="14"
                                                        Foreground="#94A3B8"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding SelectedPatient.DateNaissanceAffichee, TargetNullValue='—'}"
                                               FontSize="13"
                                               Foreground="#94A3B8"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Corps du détail -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">

                            <!-- Groupe sanguin -->
                            <Border Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="GROUPE SANGUIN"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#9CA3AF"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="28" Height="28"
                                                CornerRadius="8"
                                                Background="#FEE2E2"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <mah:PackIconLucide Kind="Droplet"
                                                                Width="16" Height="16"
                                                                Foreground="#EF4444"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding SelectedPatient.GroupeSanguin, TargetNullValue='—'}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="#111827"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Contact & Localisation -->
                            <Border Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="CONTACT &amp; LOCALISATION"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#9CA3AF"
                                               Margin="0,0,0,12"/>

                                    <!-- Téléphone -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="32" Height="32"
                                                CornerRadius="8"
                                                Background="#DBEAFE"
                                                Margin="0,0,12,0">
                                            <mah:PackIconLucide Kind="Phone"
                                                                Width="15" Height="15"
                                                                Foreground="#3B82F6"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding SelectedPatient.Telephone, TargetNullValue='—'}"
                                                   FontSize="14"
                                                   Foreground="#374151"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Email -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="32" Height="32"
                                                CornerRadius="8"
                                                Background="#DBEAFE"
                                                Margin="0,0,12,0">
                                            <mah:PackIconLucide Kind="Mail"
                                                                Width="15" Height="15"
                                                                Foreground="#3B82F6"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding SelectedPatient.Contact, TargetNullValue='—'}"
                                                   FontSize="14"
                                                   Foreground="#374151"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Adresse -->
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="32" Height="32"
                                                CornerRadius="8"
                                                Background="#DBEAFE"
                                                Margin="0,0,12,0">
                                            <mah:PackIconLucide Kind="MapPin"
                                                                Width="15" Height="15"
                                                                Foreground="#3B82F6"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding SelectedPatient.Adresse, TargetNullValue='—'}"
                                                   FontSize="14"
                                                   Foreground="#374151"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            
                            
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>