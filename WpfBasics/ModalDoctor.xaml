<Window x:Class="WpfBasics.ModalDoctor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfBasics"
        mc:Ignorable="d"
        Title="Nouveau Docteur"
        Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        Background="Transparent"
        Loaded="Window_Loaded"
        ResizeMode="NoResize">
    



    <Border Background="White"                
                Width="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="28"                        
                >



        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <TextBlock x:Name="TitreModal"
                           Text="Nouveau docteur"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- ========== FORMULAIRE ========== -->
            <StackPanel Grid.Row="1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                <TextBlock Text="NOM"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#6B7280"
                               Grid.Column="0"
                               Margin="0,0,0,6"/>
                <TextBlock Text="PRENOM"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#6B7280"
                               Grid.Column="2"
                               Margin="0,0,0,6"/>
                </Grid>
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="txtNom"
                                 Grid.Column="0"
                                 Height="40"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 BorderBrush="#E5E7EB"
                                 BorderThickness="1"                                
                                 Background="White">
                                
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <TextBox x:Name="txtPrenom"
                                 Grid.Column="2"
                                 Height="40"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="14"
                                 BorderBrush="#E5E7EB"
                                 BorderThickness="1"
                                 Background="White">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </Grid>

                <!-- SPECIALTY + AVAILABILITY (Sexe) -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Specialty -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SPECIALITE"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#6B7280"
                                       Margin="0,0,0,6"/>
                        <ComboBox x:Name="cbSpecialite"
                                      Height="40"
                                      Padding="8,0"
                                      VerticalContentAlignment="Center"
                                      FontSize="14"
                                      BorderBrush="#E5E7EB"
                                      BorderThickness="1"
                                      Background="White">
                            <ComboBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </ComboBox.Resources>
                            <ComboBoxItem Content="Médecine Générale"/>
                            <ComboBoxItem Content="Cardiologie"/>
                            <ComboBoxItem Content="Pédiatrie"/>
                            <ComboBoxItem Content="Chirurgie"/>
                            <ComboBoxItem Content="Dermatologie"/>
                            <ComboBoxItem Content="Neurologie"/>
                            <ComboBoxItem Content="Gynécologie"/>
                            <ComboBoxItem Content="Ophtalmologie"/>
                            <ComboBoxItem Content="Orthopédie"/>
                            <ComboBoxItem Content="Psychiatrie"/>
                            <ComboBoxItem Content="ORL"/>
                            <ComboBoxItem Content="Urologie"/>
                            <ComboBoxItem Content="Endocrinologie"/>
                            <ComboBoxItem Content="Oncologie"/>
                            <ComboBoxItem Content="Anesthésie"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Availability / Sexe -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SEXE"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#6B7280"
                                       Margin="0,0,0,6"/>
                        <ComboBox x:Name="cbSexe"
                                      Height="40"
                                      Padding="8,0"
                                      VerticalContentAlignment="Center"
                                      FontSize="14"
                                      BorderBrush="#E5E7EB"
                                      BorderThickness="1"
                                      Background="White">
                            <ComboBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </ComboBox.Resources>
                            <ComboBoxItem Content="M"/>
                            <ComboBoxItem Content="F"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- PHONE -->
                <TextBlock Text="TELEPHONE"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#6B7280"
                               Margin="0,0,0,6"/>
                <TextBox x:Name="txtTelephone"
                             Height="40"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             BorderBrush="#E5E7EB"
                             BorderThickness="1"
                             Background="White"
                             Margin="0,0,0,18">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- EMAIL -->
                <TextBlock Text="EMAIL"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#6B7280"
                               Margin="0,0,0,6"/>
                <TextBox x:Name="txtEmail"
                             Height="40"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             BorderBrush="#E5E7EB"
                             BorderThickness="1"
                             Background="White"
                             Margin="0,0,0,18">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- ID Docteur --> 
                <TextBlock Text="ID DOCTEUR"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#6B7280"
                               Margin="0,0,0,6"/>
                <TextBox x:Name="txtIdDocteur"
                             Height="40"
                             Padding="12,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             BorderBrush="#E5E7EB"
                             BorderThickness="1"
                             Background="White">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

            </StackPanel>

            <!-- ========== BOUTONS ========== -->
            <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,28,0,0">

                <!-- Cancel -->
                <Button Content="Cancel"
                            Height="40"
                            Padding="22,0"
                            Margin="0,0,12,0"
                            Background="White"
                            Foreground="#374151"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            FontWeight="SemiBold"
                            FontSize="14"
                            Cursor="Hand"
                            Click="BtnCancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Add -->
                <Button x:Name="BtnSave"
                        Content="Enregistrer"
                        Height="40"
                        Padding="28,0"
                        Background="#3B82F6"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        FontSize="14"
                        Cursor="Hand"
                        Click="BtnAdd_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

        </Grid>
    </Border>
</Window>