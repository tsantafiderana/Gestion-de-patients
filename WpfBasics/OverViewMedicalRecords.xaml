<UserControl x:Class="WpfBasics.OverViewMedicalRecords"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfBasics"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    

    <Grid Grid.Row="2" Margin="0 15 0 0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--Consultation Aperçu-->

    <Border
        Grid.Column="0" 
        Background="#fff"
        Margin="0 0 7.5 0"
        Padding="15 17.5"
        CornerRadius="15">
        <StackPanel>
            <Border BorderThickness="0 0 0 0.25" Padding="0 0 0 12.5" BorderBrush="Gray" Margin="0 0 0 10">
                <!--Titre-->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Historique de consultations" FontWeight="SemiBold" FontSize="14" Grid.Column="0"/>
                    <!--<TextBlock Text="Total : 14" Grid.Column="2"/>-->
                </Grid>
            </Border>
            <!--Aperçu consultation (3 derniers)-->
            <ItemsControl ItemsSource="{Binding ConsultationsApercu}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8.5" BorderBrush="#e5e7ea" BorderThickness="1"
CornerRadius="7.5" Margin="0 0 0 10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <Border Padding="7.5" Background="#e5f1ff" CornerRadius="5" Margin="0 0 10 0">
                                        <mah:PackIconLucide Kind="Stethoscope"
                            Width="17.5" Height="17.5"
                            Foreground="#2365e6"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Motif}"
                   FontWeight="DemiBold" FontSize="12.5"/>
                                        <TextBlock Text="{Binding NomDocteur}"
                   FontSize="11" Foreground="Gray"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
           Text="{Binding DateConsultation, StringFormat='dd/MM/yyyy'}"
           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>

    <!--Prescriptions aperçu-->
    <Border
        Grid.Column="1" 
        Background="#fff"
        Margin="7.5 0 0 0"
        Padding="15 17.5"
        CornerRadius="15">
        <StackPanel>

            <Border BorderThickness="0 0 0 0.25" Padding="0 0 0 12.5" BorderBrush="Gray" Margin="0 0 0 10">
                <!--Titre-->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Historique de Prescriptions" FontWeight="SemiBold" FontSize="14" Grid.Column="0"/>
                    <!--<TextBlock Text="Total : 14" Grid.Column="2"/>-->
                </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding PrescriptionsAperçu}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8.5" 
BorderBrush="#e5e7ea" 
BorderThickness="1"
CornerRadius="7.5" 
Margin="0 0 0 10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <Border Padding="7.5" 
            Background="#e5f1ff" 
            CornerRadius="5" 
            Margin="0 0 10 0">
                                        <mah:PackIconLucide Kind="pill" 
                            Width="17.5" 
                            Height="17.5" 
                            Foreground="#2365e6"/>
                                    </Border>

                                    <StackPanel>
                                        <TextBlock Text="{Binding NomMedicament}"
                   FontWeight="DemiBold" 
                   FontSize="12.5"/>
                                        <TextBlock Text="{Binding Posologie}"
                   FontSize="11" 
                   Foreground="Gray"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
           Text="{Binding DureeTraitement, StringFormat='{}{0} jours'}"
           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
    </Grid>
</UserControl>
