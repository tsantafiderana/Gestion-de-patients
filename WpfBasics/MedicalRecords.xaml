<UserControl x:Class="WpfBasics.MedicalRecords"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfBasics"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <local:InitialsConverter x:Key="InitialsConverter"/>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <local:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Padding="15" Background="#e5e7eb">
        <!-- ⚠️  IMPORTANT : Grid au lieu de StackPanel -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Titre -->
                <RowDefinition Height="*"/>
                <!-- Contenu principal -->
            </Grid.RowDefinitions>

            <!-- ========== TITRE ========== -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#1f2937"
                           Margin="0,0,0,4"
                           Text="Dossiers Médicaux"/>
                <TextBlock FontSize="14" 
                           FontWeight="Light" 
                           x:Name="txtNombrePatients"/>
            </StackPanel>

            <!-- ========== CONTENU PRINCIPAL ========== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- ========== COLONNE GAUCHE : Liste des patients ========== -->
                <Border Grid.Column="0"
                        Background="#fff"
                        BorderBrush="#e4e4e4"
                        BorderThickness="1"
                        CornerRadius="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Barre de recherche -->
                        <Border Grid.Row="0"
                                Background="#F3F4F6"
                                CornerRadius="20"
                                Margin="12,12,12,8"
                                Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <mah:PackIconLucide Kind="Search"
                                                    Width="16" Height="16"
                                                    Foreground="#9CA3AF"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>

                                <TextBox x:Name="SearchBox"
                                         Grid.Column="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="14"
                                         Foreground="#374151"
                                         VerticalContentAlignment="Center"
                                         TextChanged="SearchBox_TextChanged">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Focusable="False"
                                                                      HorizontalScrollBarVisibility="Hidden"
                                                                      VerticalScrollBarVisibility="Hidden"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <VisualBrush Stretch="None" AlignmentX="Left">
                                                                <VisualBrush.Visual>
                                                                    <TextBlock Text="Search patient..."
                                                                               Foreground="#9CA3AF"
                                                                               FontSize="14"/>
                                                                </VisualBrush.Visual>
                                                            </VisualBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </Border>

                        <!-- Liste scrollable -->
                        <ListBox x:Name="PatientListBox"
                                 Grid.Row="1"
                                 ItemsSource="{Binding FilteredPatients}"
                                 SelectedItem="{Binding SelectedPatient, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="4,0,4,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="#E5E7EB"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="12,10"
                                                        CornerRadius="10"
                                                        Margin="4,2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD"/>
                                                        <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsSelected" Value="True"/>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Initiales -->
                                        <Border Grid.Column="0"
                                                Width="40" Height="40"
                                                CornerRadius="20"
                                                Background="#DBEAFE"
                                                Margin="0,0,12,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initials}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1D4ED8"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Nom + infos -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding NomComplet}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1F2937"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="13"
                                                       Foreground="#6B7280"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} y · {1}">
                                                        <Binding Path="Age"/>
                                                        <Binding Path="GroupeSanguin"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Chevron -->
                                        <mah:PackIconLucide Kind="ChevronRight"
                                                            Grid.Column="2"
                                                            Width="16" Height="16"
                                                            Foreground="#9CA3AF"
                                                            VerticalAlignment="Center"
                                                            Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- ========== COLONNE DROITE : Dossier médical ========== -->
                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Infos patient -->
                        <RowDefinition Height="Auto"/>
                        <!-- Navigation -->
                        <RowDefinition Height="*"/>
                        <!-- Contenu (Aperçu / Consultations...) -->
                    </Grid.RowDefinitions>

                    <!-- Infos patient -->
                    <Border Grid.Row="0" 
                            Background="#fff" 
                            BorderBrush="#e4e4e4" 
                            BorderThickness="1" 
                            CornerRadius="15" 
                            Padding="15,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Border Height="56" Width="56" 
                                        CornerRadius="7.5" 
                                        Margin="0,0,12,0">
                                    <TextBlock Foreground="White" 
                                               FontSize="22.5" 
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Text="{Binding SelectedPatient.NomComplet, Converter={StaticResource InitialsConverter}}"/>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#6B7280"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedPatient.Sexe}" Value="M">
                                                    <Setter Property="Background" Value="#3B82F6"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedPatient.Sexe}" Value="F">
                                                    <Setter Property="Background" Value="#EC4899"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" FontSize="18"
                                                   Text="{Binding SelectedPatient.NomComplet}"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock FontSize="18" FontWeight="SemiBold"
                                                   Text="{Binding SelectedPatient.IdPatient, StringFormat='- {0}'}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Foreground="Gray" FontSize="14" Margin="0,0,6,0"
                                                   Text="{Binding SelectedPatient.Sexe, StringFormat='{}{0} ·'}"/>
                                        <TextBlock Foreground="Gray" FontSize="14" Margin="0,0,6,0"
                                                   Text="{Binding SelectedPatient.Age, StringFormat='{}{0} ans ·'}"/>
                                        <TextBlock Foreground="Gray" FontSize="14" Margin="0,0,6,0"
                                                   Text="{Binding SelectedPatient.GroupeSanguin, StringFormat='{}{0} ·'}"/>
                                        <TextBlock Foreground="Gray" FontSize="14"
                                                   Text="{Binding SelectedPatient.Adresse}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Navigation -->
                    <Border Grid.Row="1" 
                            Background="#fff" 
                            Padding="7.5" 
                            BorderThickness="1" 
                            BorderBrush="#e4e4e4" 
                            Margin="0,15,0,0" 
                            CornerRadius="10">
                        <ListBox SelectionChanged="ListBox_SelectionChanged" 
                                 x:Name="NavListBox"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBoxItem Tag="overview">
                                <TextBlock Text="Aperçu" Margin="10,6"/>
                            </ListBoxItem>
                            <ListBoxItem Tag="consultations">
                                <TextBlock Text="Consultations" Margin="10,6"/>
                            </ListBoxItem>
                            <ListBoxItem Tag="prescriptions">
                                <TextBlock Text="Prescriptions" Margin="10,6"/>
                            </ListBoxItem>
                        </ListBox>
                    </Border>

                    <!-- Contenu dynamique -->
                    <ContentControl x:Name="ChangedContent" 
                                    Grid.Row="2" 
                                    Margin="0,15,0,0"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>