<UserControl x:Class="WpfBasics.ModalConsultation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfBasics"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="780" d:DesignWidth="560"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#80000000" MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
        <Border Width="540" MaxHeight="760"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" CornerRadius="16"
                MouseLeftButtonDown="Modal_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.25" Color="#000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- EN-TÊTE -->
                <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="16,16,0,0" Padding="24,20">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#DBEAFE" Width="40" Height="40" CornerRadius="10" Margin="0,0,14,0">
                                <iconPacks:PackIconLucide Kind="Stethoscope" Width="20" Height="20"
                                                          Foreground="#2563EB"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Nouvelle consultation" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Enregistrer une consultation et éventuellement générer une facture"
                                           FontSize="13" Foreground="#6B7280" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="32" Height="32" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="BtnFermer_Click">
                            <iconPacks:PackIconLucide Kind="X" Width="18" Height="18" Foreground="#6B7280"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- CORPS -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,12">

                        <!-- Médecin -->
                        <TextBlock Text="Médecin *" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbDocteur" Style="{StaticResource ModernComboBox}"
                                  DisplayMemberPath="NomComplet" SelectedValuePath="IdDocteur"
                                  Margin="0,0,0,14"/>

                        <!-- Rendez-vous -->
                        <TextBlock Text="Rendez-vous *" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbRendezVous" Style="{StaticResource ModernComboBox}"
                                  DisplayMemberPath="Libelle" SelectedValuePath="IdRendezVous"
                                  Margin="0,0,0,14" SelectionChanged="CmbRendezVous_SelectionChanged"/>

                        <!-- Dossier médical (rempli automatiquement) -->
                        <TextBlock Text="Dossier médical" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtIdDossier" Style="{StaticResource ModernTextBox}"
                                 IsReadOnly="True" Background="#F9FAFB" Margin="0,0,0,14"/>

                        <!-- Date -->
                        <TextBlock Text="Date de consultation" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,6"/>
                        <DatePicker x:Name="DpDateConsultation" Height="40" FontSize="14"
                                    SelectedDate="{x:Static sys:DateTime.Today}" Margin="0,0,0,14"/>

                        <!-- Motif -->
                        <TextBlock Text="Motif *" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtMotif" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                        <!-- Diagnostic -->
                        <TextBlock Text="Diagnostic" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtDiagnostic" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

                        <!-- Observation -->
                        <TextBlock Text="Observation" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtObservation" Style="{StaticResource ModernTextBox}"
                                 Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" Padding="12,10" Margin="0,0,0,14"/>

                        <!-- Conclusion -->
                        <TextBlock Text="Conclusion / Traitement" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtConclusion" Style="{StaticResource ModernTextBox}"
                                 Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" Padding="12,10" Margin="0,0,0,20"/>

                        <!-- Séparateur -->
                        <Border Height="1" Background="#E5E7EB" Margin="0,0,0,16"/>

                        <!-- Générer facture -->
                        <CheckBox x:Name="ChkGenererFacture"
                                  Content="Générer une facture maintenant"
                                  FontSize="14" FontWeight="Medium"
                                  Margin="0,0,0,14"
                                  Checked="ChkGenererFacture_Checked"
                                  Unchecked="ChkGenererFacture_Unchecked"/>

                        <!-- Zone facture (cachée par défaut) -->
                        <StackPanel x:Name="PanelFacture" Visibility="Collapsed">
                            <TextBlock Text="Service / Motif de facturation" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CmbServiceFacture" Style="{StaticResource ModernComboBox}" IsEditable="True" Margin="0,0,0,12">
                                <ComboBoxItem Content="Consultation"/>
                                <ComboBoxItem Content="Consultation + Lab"/>
                                <ComboBoxItem Content="Suivi"/>
                                <ComboBoxItem Content="Cardiologie"/>
                                <ComboBoxItem Content="Dermatologie"/>
                                <ComboBoxItem Content="Pédiatrie"/>
                                <ComboBoxItem Content="Analyses de laboratoire"/>
                                <ComboBoxItem Content="Autre"/>
                            </ComboBox>

                            <TextBlock Text="Montant de la facture (Ar)" FontSize="13" FontWeight="Medium" Foreground="#374151" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <TextBox x:Name="TxtMontantFacture" Style="{StaticResource ModernTextBox}"
                                         PreviewTextInput="TxtMontant_PreviewTextInput"/>
                                <TextBlock Text="Ar" VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Margin="0,0,14,0" Foreground="#6B7280" FontWeight="Medium"/>
                            </Grid>

                            <CheckBox x:Name="ChkEncaisserMaintenant"
                                      Content="Enregistrer le paiement immédiatement"
                                      FontSize="13" Margin="0,0,0,12"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- PIED -->
                <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,16,16" Padding="24,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Annuler"
                                Style="{StaticResource BtnSecondary}" Margin="0,0,8,0"
                                Click="BtnFermer_Click"/>

                        <Button Grid.Column="1" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0"
                                Click="BtnEnregistrer_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Check" Width="16" Height="16" Foreground="White" Margin="0,0,8,0"/>
                                <TextBlock Text="Enregistrer" Foreground="White" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>