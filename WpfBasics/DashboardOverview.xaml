<UserControl x:Class="WpfBasics.DashboardOverview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfBasics"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Border Padding="0 15 0 15" Margin="0 15 0 0" >
        <Grid Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="15 10" Margin="0 0 0 15">
                <!-- BorderBrush="Black" BorderThickness="0 0.5 0 0.5"> -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tableau de bord" Foreground="#00355f" FontWeight="SemiBold" FontSize="20"/>
                        <TextBlock Text="Bienvenue Dr Fiderana, vous avez 12 patients aujourd'hui" Foreground="#76869b" FontSize="15"/>
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Padding="10 0" Height="35" Margin="10 0" Content="Exporter les données"/>
                        <Button Grid.Column="1" Padding="10 0" Height="35" Margin="10 0" Content="Nouveau patient"/>
                    </Grid>




                </Grid>
            </Border>

            <Border Margin="5 5 0 5" Padding="15 15 15 15" Grid.Row="1" Background="#f3f3f3" >
                <Grid Grid.Row="1" Margin="0 0" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <Border Grid.Column="0"
                            Background="white"
                            BorderThickness="0.5" 
                            BorderBrush="Black" 
                            Margin="0 0 7.5 0"
                            CornerRadius="10"
                            Padding="15 15">

                        <StackPanel>
                            <TextBlock 
                            Text="TOTAL DES PATIENTS AUJOURD'HUI"
                            Margin="0 0 0 5"/>
                            <TextBlock 
                Text="28" 
                FontSize="25" 
                FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" 
            BorderThickness="0.5" 
            Background="white"
            BorderBrush="Black" 
            Margin="2.5 0 5 0"
            CornerRadius="10"
            Padding="15 15">
                        <StackPanel>
                            <TextBlock 
                Text="RENDEZ-VOUS A VENIR"
                Margin="0 0 0 5"/>

                            <TextBlock 
                Text="7" 
                FontSize="25" 
                FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" 
            BorderThickness="0.5" 
            Background="white"
            BorderBrush="Black" 
            Margin="5 0 2.5 0"
            CornerRadius="10"
            Padding="15 15">
                        <StackPanel>
                            <TextBlock 
                Text="ALERTS CRITIQUES"
                Margin="0 0 0 5"/>
                            <TextBlock 
                Text="3" 
                FontSize="25" 
                FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" 
            BorderThickness="0.5" 
            BorderBrush="Black" 
            Background="white"
            Margin="7.5 0 0 0"
            CornerRadius="10"
            Padding="15 15">
                        <StackPanel>
                            <TextBlock 
                Text="REVENUS DU JOUR"
                Margin="0 0 0 5"/>
                            <TextBlock 
                Text="Ar 55 000" 
                FontSize="25" 
                FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <Border Background="#f3f3f3" Grid.Row="2" Margin="5 0 5 0" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="#e4e4e4" BorderThickness="1" Grid.Column="0">
                        <Grid Background="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Margin="0 0 0 10" 
                                    Padding="5 7.5"  
                                    Background="#f1f5f9"
                                    BorderBrush="#e4e4e4" 
                                    BorderThickness="0 0 0 1">

                                <TextBlock Text="PLANNING DU JOUR"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#00355f"/>

                            </Border>

                            <Border Grid.Row="1" Margin="5 0" BorderBrush="#e4e4e4" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="◀"
                                            Width="25" 
                                            Height="25"
                                            Margin="5"/>

                                    <Button Grid.Column="2" Content="▶"
                                            Width="25" 
                                            Height="25"
                                            Margin="5"/>

                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Margin="5 0" Padding="0 10 0 0">
                                <ItemsControl ItemsSource="{Binding Planning}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Background}"
                                                    BorderBrush="{Binding BorderColor}"
                                                    BorderThickness="5 0 0 0"
                                                    Height="60"
                                                    Padding="10 5 5 5"
                                                    Margin="0 0 0 5">
                                                    <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Text="{Binding Heure}" FontSize="10.5" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Row="1" Text="{Binding Nom}" FontSize="14.5" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Row="2" Text="{Binding Description}" Margin="0 2 0 0" Foreground="#a1a1a1" FontWeight="SemiBold"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>




                            </Border>
                        </Grid>
                    </Border>

                    <Border  Grid.Column="1" Margin="5 0 5 0" Background="White" BorderBrush="#e4e4e4" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Margin="0 0 0 10" Grid.Row="0" 
                                    Padding="5 7.5"  
                                    Background="#f1f5f9"
                                    BorderBrush="#e4e4e4" 
                                    BorderThickness="0 0 0 1">

                                <TextBlock Text="TRANSACTIONS RECENTES"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#00355f"/>

                            </Border>


                        </Grid>
                    </Border>
                   
                </Grid>
            </Border>
            
            

        </Grid>
        
    </Border>
    
</UserControl>
