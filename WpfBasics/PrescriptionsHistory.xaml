<UserControl x:Class="WpfBasics.PrescriptionsHistory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfBasics"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="#fff" CornerRadius="15" Padding="0 17.5" Margin="0 12 0 0">
        <StackPanel>
            <Border BorderThickness="0 0 0 0.25" Padding="15 0 15 12.5" BorderBrush="Gray" Margin="0 0 0 10" >

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                        <Border Padding="7.5" Background="#e5f1ff" CornerRadius="5" Margin="0 0 10 0" VerticalAlignment="Center">
                            <mah:PackIconLucide Kind="Pill"
                                                Width="17.5" Height="17.5"
                                                Foreground="#2365e6"/>
                        </Border>
                        <TextBlock Text="Historique de prescriptions du patient" FontWeight="SemiBold" FontSize="14" Grid.Column="0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!--<TextBlock Text="Total : 14" Grid.Column="2"/>-->
                </Grid>
            </Border>

            <Border Padding="15 0" CornerRadius="15">
                <StackPanel>
                    <Grid Background="#f6f9fb">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="0.75*"/>
                            <ColumnDefinition Width="0.75*"/>
                            
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="0.75*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Padding="10" FontSize="14" FontWeight="DemiBold" Text="Docteur"/>
                        <TextBlock Grid.Column="1" Padding="10" FontSize="14" FontWeight="DemiBold" Text="Médicament"/>
                        <TextBlock Grid.Column="2" Padding="10" FontSize="14" FontWeight="DemiBold" Text="Posologie"/>
                        <TextBlock Grid.Column="3" Padding="10" FontSize="14" FontWeight="DemiBold" Text="Quantité"/>
                        <TextBlock Grid.Column="4" Padding="10" FontSize="14" FontWeight="DemiBold" Text="Durée"/>
                        <TextBlock Grid.Column="5" Padding="10" FontSize="14" FontWeight="DemiBold" Text="Instructions"/>
                        <TextBlock Grid.Column="6" Padding="10" FontSize="14" FontWeight="DemiBold" Text="Date"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Prescription}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="0.75*"/>
                                        <ColumnDefinition Width="0.75*"/>
                                        <ColumnDefinition Width="1.25*"/>
                                        <ColumnDefinition Width="0.75*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Padding="10" FontSize="13"
                                                TextWrapping="Wrap"  Text="{Binding NomDocteur}"/>
                                    <TextBlock Grid.Column="1" Padding="10" FontSize="13"
                                                TextWrapping="Wrap"  Text="{Binding NomMedicament}"/>
                                    <TextBlock Grid.Column="2" Padding="10" FontSize="13"
                                                TextWrapping="Wrap"  Text="{Binding Posologie}"/>
                                    <TextBlock Grid.Column="3" Padding="10" FontSize="13"
                                                TextWrapping="Wrap"  Text="{Binding Quantite}"/>
                                    <TextBlock Grid.Column="4" Padding="10" FontSize="13"
                                                TextWrapping="Wrap"  Text="{Binding DureeTraitement}"/>
                                    <TextBlock Grid.Column="5" Padding="10" FontSize="13"
                                                TextWrapping="Wrap"  Text="{Binding Instructions}"/>
                                    <TextBlock Grid.Column="6" Padding="10" FontSize="13"
                                                TextWrapping="Wrap"  Text="{Binding DatePrescription, StringFormat='{}{0:dd MMMM yyyy}'}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </Border>
</UserControl>
