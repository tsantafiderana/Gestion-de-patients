<UserControl x:Class="WpfBasics.DashboardFinance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfBasics"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1400"
             Background="#F5F7FA">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Style carte KPI -->
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style bouton secondaire -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style bouton primaire -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- ========== GRID RACINE ========== -->
    <Grid>
        <!-- Contenu scrollable -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ========== KPI CARDS ========== -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="Revenu ce mois" FontSize="13" Foreground="#6B7280"/>
                            <TextBlock x:Name="TxtRevenuMois" Text="Ar 0" FontSize="28" FontWeight="Bold" Margin="0,6,0,4"/>
                            <TextBlock x:Name="TxtEvolutionRevenu" Text="+0 %" Foreground="#10B981" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="En attente" FontSize="13" Foreground="#6B7280"/>
                            <TextBlock x:Name="TxtEnAttente" Text="Ar 0" FontSize="28" FontWeight="Bold" Margin="0,6,0,4"/>
                            <TextBlock x:Name="TxtNbFacturesAttente" Text="0 facture" Foreground="#F59E0B" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="Factures payées" FontSize="13" Foreground="#6B7280"/>
                            <TextBlock x:Name="TxtFacturesPayees" Text="0" FontSize="28" FontWeight="Bold" Margin="0,6,0,4"/>
                            <TextBlock x:Name="TxtTauxRecouvrement" Text="0 % recouvrement" Foreground="#3B82F6" FontSize="13"/>
                        </StackPanel>
                    </Border>

                    
                </Grid>

                <!-- ========== GRAPHIQUE + MÉTHODES (commenté pour l'instant) ========== -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                </Grid>

                
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tableau des factures -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,16,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Factures" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0">
                                        <!--<StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="Download" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Exporter"/>
                                        </StackPanel>-->
                                    </Button>
                                    <Button Style="{StaticResource PrimaryButton}" Click="BtnNouvelleFacture_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconLucide Kind="Plus" Width="16" Height="16" Margin="0,0,6,0" Foreground="White"/>
                                            <TextBlock Text="Nouvelle facture" Foreground="White"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="DgFactures"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionChanged="DgFactures_SelectionChanged"
                                      BorderThickness="0"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      RowBackground="White"
                                      AlternatingRowBackground="#F8FAFC"
                                      FontSize="13">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="12,10"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="12,10"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="FACTURE" Binding="{Binding IdFacture}" Width="100"/>
                                    <DataGridTextColumn Header="PATIENT" Binding="{Binding NomPatient}" Width="*"/>
                                    <DataGridTextColumn Header="SERVICE" Binding="{Binding Service}" Width="*"/>
                                    <DataGridTextColumn Header="MONTANT" Binding="{Binding Montant, StringFormat=Ar {0:N2}}" Width="100"/>
                                    <DataGridTextColumn Header="DATE" Binding="{Binding DateFacture, StringFormat=dd MMM}" Width="90"/>
                                    <DataGridTemplateColumn Header="STATUT" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Badge" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="TxtStatut" Text="{Binding Statut}" FontSize="12"/>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Payée">
                                                        <Setter TargetName="Badge" Property="Background" Value="#D1FAE5"/>
                                                        <Setter TargetName="TxtStatut" Property="Foreground" Value="#065F46"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="En attente">
                                                        <Setter TargetName="Badge" Property="Background" Value="#FEF3C7"/>
                                                        <Setter TargetName="TxtStatut" Property="Foreground" Value="#92400E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="Partielle">
                                                        <Setter TargetName="Badge" Property="Background" Value="#FEF3C7"/>
                                                        <Setter TargetName="TxtStatut" Property="Foreground" Value="#92400E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Statut}" Value="En retard">
                                                        <Setter TargetName="Badge" Property="Background" Value="#FEE2E2"/>
                                                        <Setter TargetName="TxtStatut" Property="Foreground" Value="#991B1B"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="ACTIONS" Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Marquer payée"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Padding="8,4"
                                                        FontSize="12"
                                                        Visibility="{Binding PeutMarquerPayee, Converter={StaticResource BoolToVis}}"
                                                        Click="BtnMarquerPayee_Click"
                                                        Tag="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Détail de la facture -->
                    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.08" Color="Black"/>
                        </Border.Effect>
                        <StackPanel x:Name="PanelDetailFacture">
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock x:Name="TxtDetailNumero" Text="Facture #—" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtDetailDate" Text="—" FontSize="13" Foreground="#6B7280" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border x:Name="BadgeDetailStatut" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="#D1FAE5" CornerRadius="12" Padding="12,5">
                                    <TextBlock x:Name="TxtDetailStatut" Text="● —" Foreground="#065F46" FontSize="13"/>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Patient" Foreground="#6B7280"/>
                                <TextBlock x:Name="TxtDetailPatient" Text="—" HorizontalAlignment="Right" FontWeight="Medium"/>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Service" Foreground="#6B7280"/>
                                <TextBlock x:Name="TxtDetailService" Text="—" HorizontalAlignment="Right" FontWeight="Medium"/>
                            </Grid>
                            <Separator Margin="0,8,0,16" Background="#E5E7EB"/>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Sous-total" Foreground="#6B7280"/>
                                <TextBlock x:Name="TxtDetailSousTotal" Text="Ar 0.00" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="TVA (0 %)" Foreground="#6B7280"/>
                                <TextBlock x:Name="TxtDetailTva" Text="Ar 0.00" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,24">
                                <TextBlock Text="Total" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock x:Name="TxtDetailTotal" Text="Ar 0.00" HorizontalAlignment="Right" FontWeight="Bold" FontSize="18"/>
                            </Grid>
                            <Separator Margin="0,8,0,16" Background="#E5E7EB"/>

                            <!-- Résumé paiement -->
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Déjà payé" Foreground="#6B7280"/>
                                <TextBlock x:Name="TxtDetailDejaPaye" Text="Ar 0.00" HorizontalAlignment="Right" Foreground="#10B981"/>
                            </Grid>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Reste à payer" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtDetailReste" Text="Ar 0.00" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#2563EB"/>
                            </Grid>

                            <!-- Historique des paiements -->
                            <TextBlock Text="Historique des paiements" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="ListePaiements">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DatePaiement, StringFormat=dd/MM/yyyy}" FontSize="12" Foreground="#6B7280"/>
                                                <TextBlock Text="{Binding Methode}" FontSize="13"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" 
                           Text="{Binding MontantPaye, StringFormat=Ar {0:N2}}" 
                           FontWeight="Medium" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!--MODAL PAIEMENT  -->
        <Grid x:Name="ModalOverlay"
              Visibility="Collapsed"
              Panel.ZIndex="100"
              Background="Transparent">
            <local:ModalPayement x:Name="ModalPaiement"/>
        </Grid>

        <!--MODAL FACTURE -->

        <Grid x:Name="ModalOverlayFacture" Visibility="Collapsed" Panel.ZIndex="100">
            <local:ModalNouvelleFacture x:Name="ModalNouvelleFacture"/>
        </Grid>
    </Grid>
</UserControl>