<UserControl x:Class="WpfBasics.ModalPayement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfBasics"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="620" d:DesignWidth="480"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Style TextBox moderne -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton secondaire -->
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F9FAFB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Bouton primaire -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Overlay sombre -->
    <Grid Background="#80000000" MouseLeftButtonDown="Overlay_MouseLeftButtonDown">

        <!-- Carte du modal -->
        <Border Width="440" 
                MaxHeight="620"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="16"
                MouseLeftButtonDown="Modal_MouseLeftButtonDown">

            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.25" Color="#000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ========== EN-TÊTE ========== -->
                <Border Grid.Row="0" 
                        Background="#F8FAFC" 
                        CornerRadius="16,16,0,0" 
                        Padding="24,20">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#DBEAFE" 
                                    Width="40" Height="40" 
                                    CornerRadius="10" 
                                    Margin="0,0,14,0">
                                <iconPacks:PackIconLucide Kind="CreditCard" 
                                                          Width="20" Height="20" 
                                                          Foreground="#2563EB"
                                                          HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Enregistrer un paiement" 
                                           FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtSousTitre" 
                                           Text="Facture #INV-1024" 
                                           FontSize="13" 
                                           Foreground="#6B7280" 
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button HorizontalAlignment="Right" 
                                VerticalAlignment="Center"
                                Width="32" Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnFermer_Click">
                            <iconPacks:PackIconLucide Kind="X" Width="18" Height="18" Foreground="#6B7280"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ========== CORPS ========== -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,8">

                        
                        <!-- Info patient + résumé montants -->
                        <Border Background="#F0F9FF" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Patient" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtPatient" Text="Rakoto Jean" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Montant total" FontSize="13" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtMontantTotal" Text="Ar 0.00" HorizontalAlignment="Right" FontWeight="Medium"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Déjà payé" FontSize="13" Foreground="#64748B"/>
                                    <TextBlock x:Name="TxtDejaPaye" Text="Ar 0.00" HorizontalAlignment="Right" Foreground="#10B981"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Reste à payer" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                                    <TextBlock x:Name="TxtMontantDu" Text="Ar 0.00" HorizontalAlignment="Right" 
                       FontSize="16" FontWeight="Bold" Foreground="#2563EB"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Montant à payer -->
                        <TextBlock Text="Montant à payer" 
                                   FontSize="13" 
                                   FontWeight="Medium" 
                                   Foreground="#374151" 
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <TextBox x:Name="TxtMontantPaye" 
                                     Style="{StaticResource ModernTextBox}"
                                     Text="120.00"
                                     PreviewTextInput="TxtMontant_PreviewTextInput"/>
                            <TextBlock Text="Ar" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Right" 
                                       Margin="0,0,14,0"
                                       Foreground="#6B7280"
                                       FontWeight="Medium"/>
                        </Grid>

                        <!-- Méthode de paiement -->
                        <TextBlock Text="Méthode de paiement" 
                                   FontSize="13" 
                                   FontWeight="Medium" 
                                   Foreground="#374151" 
                                   Margin="0,0,0,8"/>

                        <UniformGrid Columns="2" Rows="2" Margin="0,0,0,16">
                            <!-- Carte -->
                            <Border x:Name="BtnMethodeCarte" 
                                    Margin="0,0,6,6"
                                    Background="#EFF6FF"
                                    BorderBrush="#2563EB"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="Methode_Click"
                                    Tag="Carte">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="CreditCard" Width="18" Height="18" 
                                                              Foreground="#2563EB" Margin="0,0,10,0"/>
                                    <TextBlock Text="Carte" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Border>

                            <!-- Espèces -->
                            <Border x:Name="BtnMethodeEspeces" 
                                    Margin="6,0,0,6"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="Methode_Click"
                                    Tag="Espèces">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Banknote" Width="18" Height="18" 
                                                              Foreground="#6B7280" Margin="0,0,10,0"/>
                                    <TextBlock Text="Espèces" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Border>

                            <!-- Assurance -->
                            <Border x:Name="BtnMethodeAssurance" 
                                    Margin="0,6,6,0"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="Methode_Click"
                                    Tag="Assurance">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Shield" Width="18" Height="18" 
                                                              Foreground="#6B7280" Margin="0,0,10,0"/>
                                    <TextBlock Text="Assurance" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Border>

                            <!-- Virement -->
                            <Border x:Name="BtnMethodeVirement" 
                                    Margin="6,6,0,0"
                                    Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="12,10"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="Methode_Click"
                                    Tag="Virement">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconLucide Kind="Landmark" Width="18" Height="18" 
                                                              Foreground="#6B7280" Margin="0,0,10,0"/>
                                    <TextBlock Text="Virement" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Date du paiement -->
                        <TextBlock Text="Date du paiement" 
                                   FontSize="13" 
                                   FontWeight="Medium" 
                                   Foreground="#374151" 
                                   Margin="0,0,0,6"/>
                        <DatePicker x:Name="DpDatePaiement" 
                                    Height="40"
                                    FontSize="14"
                                    SelectedDate="{x:Static sys:DateTime.Today}"
                                    Margin="0,0,0,16"/>

                        <!-- Note -->
                        <TextBlock Text="Note (optionnelle)" 
                                   FontSize="13" 
                                   FontWeight="Medium" 
                                   Foreground="#374151" 
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtNote" 
                                 Style="{StaticResource ModernTextBox}"
                                 Height="70"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Padding="12,10"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== PIED ========== -->
                <Border Grid.Row="2" 
                        Background="#F8FAFC" 
                        CornerRadius="0,0,16,16" 
                        Padding="24,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Content="Annuler" 
                                Style="{StaticResource BtnSecondary}"
                                Margin="0,0,8,0"
                                Click="BtnFermer_Click"/>

                        <Button Grid.Column="1" 
                                Style="{StaticResource BtnPrimary}"
                                Margin="8,0,0,0"
                                Click="BtnConfirmer_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Kind="Check" Width="16" Height="16" 
                                                          Foreground="White" Margin="0,0,8,0"/>
                                <TextBlock Text="Confirmer le paiement" Foreground="White" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>